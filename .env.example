# Local backend on same machine (default if unset):
# VITE_API_BASE_URL=http://localhost:8080/api

# Backend on another laptop in LAN:
# VITE_API_BASE_URL=http://10.15.0.119:8080/api

# Ngrok / remote HTTPS (avoid browser CORS): proxy via Vite
# VITE_API_BASE_URL=/api
# VITE_API_PROXY_TARGET=https://your-subdomain.ngrok-free.dev
